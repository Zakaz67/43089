# ОТСТУПЫ (ТАБ / 4 ПРОБЕЛА)
Критически важны в Python! Определяют, какой код относится к условию.

пример:
age = 18
if age >= 18:
    print("Доступ разрешен")  # этот блок выполнится только если age >= 18
else:
    print("Доступ запрещен")

# ЛОГИЧЕСКИЕ СВЯЗКИ
and = "И" (сработает, только если ВСЕ условия истинны)
or = "ИЛИ" (сработает, если ХОТЯ БЫ ОДНО условие истинно)

пример:
is_logged_in = True
has_money = False

if is_logged_in and has_money:
    print("Покупка совершена")

if is_logged_in or has_money:
    print("Пользователь либо вошел, либо имеет деньги")

# БУЛЕВЫ ПЕРЕМЕННЫЕ В УСЛОВИЯХ
Можно проверять напрямую без == True

